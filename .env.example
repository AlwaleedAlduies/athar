DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: PostgreSQL. Otherwise a local SQLite database is used.
# DATABASE_URL=postgresql://athar:password@localhost:5432/athar
DEMO_MODE=true
LLM_PROVIDER=extractive
# extractive | openai | gemini | local
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_URL=http://127.0.0.1:11434
# Optional stable secret for encrypting API keys saved in the admin dashboard.
# If omitted, SECRET_KEY is used. Keep it unchanged and back it up separately.
# AI_CREDENTIAL_KEY=
EMBEDDING_BACKEND=hash
# hash (offline lexical vectors) | ollama (semantic embeddings)
EMBEDDING_MODEL=
AI_RATE=20/hour
